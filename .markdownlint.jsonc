{
  // markdownlint config tuned for this repo.
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "default": true,

  // MD013 (line-length): prose isn't hard-wrapped here; long URLs and
  // image embeds in announcement docs (v2.md) routinely exceed 80 cols.
  "MD013": false,

  // MD033 (no-inline-html): v2.md and README.md embed <img> tags for
  // GitHub-rendered screenshots. Allow inline HTML.
  "MD033": false
}
